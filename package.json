{
  "name": "@dwk/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the @dwk IndieWeb + Solid Cloudflare Workers packages.",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project @dwk/solid-pod",
    "test:gate": "node --test scripts/release-gate.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release:gate": "node scripts/release-gate.mjs",
    "release": "pnpm release:gate && pnpm build && changeset publish"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@cloudflare/vitest-pool-workers": "0.16.10",
    "@cloudflare/workers-types": "4.20260530.1",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-istanbul": "4.1.7",
    "eslint": "10.4.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vitest": "4.1.7",
    "wrangler": "4.95.0"
  }
}
