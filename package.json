{
  "name": "@dwk/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the @dwk IndieWeb + Solid Cloudflare Workers packages.",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project @dwk/solid-pod",
    "test:gate": "node --test scripts/release-gate.test.mjs",
    "test:catalog": "node --test scripts/catalog-gate.test.mjs",
    "catalog:check": "node scripts/catalog-gate.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release:gate": "node scripts/release-gate.mjs",
    "release": "pnpm release:gate && pnpm build && changeset publish"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "vite": "^8.1.5",
      "@opentelemetry/core": "^2.9.0",
      "body-parser": "^2.3.0",
      "sharp": "^0.35.3"
    }
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260902.1",
    "@eslint/js": "10.0.1",
    "@fedify/fedify": "2.3.6",
    "@fedify/vocab": "2.3.6",
    "@types/node": "26.4.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  }
}
