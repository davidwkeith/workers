{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/davidwkeith/workers/conformance/status.schema.json",
  "title": "Conformance status",
  "description": "Per-package conformance-suite and integration-lifecycle status consumed by the release gate.",
  "type": "object",
  "required": ["packages"],
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "packages": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/package" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "state": {
      "type": "string",
      "enum": ["pending", "failing", "passing", "not-applicable"]
    },
    "package": {
      "type": "object",
      "required": ["suites", "integration"],
      "properties": {
        "standard": { "type": ["string", "null"] },
        "suites": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/suite" }
        },
        "integration": { "$ref": "#/definitions/integration" }
      },
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/definitions/state" },
        "report": {
          "type": ["string", "null"],
          "description": "URL of the published implementation report (e.g. micropub.net/implementation-reports/)."
        },
        "lastRun": {
          "type": ["string", "null"],
          "description": "ISO-8601 timestamp of the last recorded run."
        }
      },
      "additionalProperties": false
    },
    "integration": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/definitions/state" },
        "cases": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
