{
  "$schema": "./status.schema.json",
  "description": "Single source of truth for per-package conformance and integration status. The release gate (scripts/release-gate.mjs) refuses to publish any package at a stable (>=1.0.0) version until every suite listed here is \"passing\" and its integration lifecycle tests are \"passing\". See conformance/README.md.",
  "targets": {
    "cloudflare": {
      "description": "Cloudflare Workers \u2014 the primary, recommended, conformance-certified target.",
      "host": "workerd"
    },
    "node": {
      "description": "Self-hosted Node/Express host \u2014 the @dwk/server Docker image or dwk-serve bin.",
      "host": "@dwk/server"
    },
    "fedify": {
      "description": "Fedify-based ActivityPub interop peer (scripts/conformance/fedify-peer.mjs) \u2014 a second, automatable federation implementation to test @dwk/activitypub against, alongside manual testing against Mastodon (issue #246).",
      "host": "node"
    },
    "pixelfed": {
      "description": "Manual federation run against a live Pixelfed instance (fediverse interop #273): publish {kind: note, attachments: [image]} via POST <actor>/publish and verify it renders in a Pixelfed timeline with alt text and content warning preserved; follow/like back from Pixelfed.",
      "host": "pixelfed"
    },
    "lemmy": {
      "description": "Manual federation run against a live Lemmy instance (fediverse interop #273): follow a community and receive/unwrap its announced posts, publish a titled Page into it (handle-shaped audience), reply, and vote (Like/Dislike). Also covers hosting a Group actor (#376): a Lemmy peer follows/joins the hosted community, posts to it, and receives the Announce-wrapped boost.",
      "host": "lemmy"
    }
  },
