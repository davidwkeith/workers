{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No `rootDir`: the `paths` mappings below resolve the workspace imports to
    // their source (so `typecheck` works before the workspace is built — CI runs
    // typecheck ahead of build), which would otherwise trip the
    // rootDir-containment check. This config is `noEmit`, so rootDir is moot.
    "paths": {
      "@dwk/ldn/discovery": ["../ldn/src/discovery.ts"],
      // `@dwk/ldn/discovery` references `@dwk/rdf` types (erased at build); map it
      // to source too so typecheck-before-build resolves the transitive type.
      "@dwk/rdf": ["../rdf/src/index.ts"],
      "@dwk/log": ["../log/src/index.ts"],
      "@dwk/calendar": ["../calendar/src/index.ts"]
    },
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "noEmit": true
  },
  "include": ["src"]
}
