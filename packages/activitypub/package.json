{
  "name": "@dwk/activitypub",
  "version": "0.1.0-beta.6",
  "description": "Edge-native ActivityPub actor: inbox/outbox, follower collections, signed S2S federation. Ships the per-actor Durable Object.",
  "keywords": [
    "activitypub",
    "fediverse",
    "federation",
    "actor",
    "indieweb",
    "cloudflare-workers",
    "durable-objects"
  ],
  "type": "module",
  "license": "ISC",
  "author": "David W. Keith <me@dwk.io>",
  "homepage": "https://github.com/davidwkeith/workers/tree/main/packages/activitypub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidwkeith/workers.git",
    "directory": "packages/activitypub"
  },
  "bugs": {
    "url": "https://github.com/davidwkeith/workers/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-harness.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dwk/calendar": "workspace:*",
    "@dwk/http-signatures": "workspace:*",
    "@dwk/ldn": "workspace:*",
    "@dwk/log": "workspace:*",
    "@dwk/mastodon-api": "workspace:*",
    "@dwk/mcp": "workspace:*",
    "@dwk/safe-fetch": "workspace:*",
    "@dwk/webfinger": "workspace:*"
  }
}
