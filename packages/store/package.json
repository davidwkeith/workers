{
  "name": "@dwk/store",
  "version": "0.1.0-beta.4",
  "description": "DO-SQLite quad store + R2 copy-on-write blob bodies behind one storage interface.",
  "keywords": [
    "storage",
    "durable-objects",
    "sqlite",
    "r2",
    "quad-store",
    "cloudflare-workers"
  ],
  "type": "module",
  "license": "ISC",
  "author": "David W. Keith <me@dwk.io>",
  "homepage": "https://github.com/davidwkeith/workers/tree/main/packages/store#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidwkeith/workers.git",
    "directory": "packages/store"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-harness.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dwk/rdf": "workspace:*"
  }
}
