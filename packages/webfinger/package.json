{
  "name": "@dwk/webfinger",
  "version": "1.0.0-beta.2",
  "description": "WebFinger (RFC 7033) account/resource discovery endpoint at /.well-known/webfinger.",
  "keywords": [
    "webfinger",
    "rfc7033",
    "well-known",
    "discovery",
    "cloudflare-workers"
  ],
  "type": "module",
  "license": "ISC",
  "author": "David W. Keith <me@dwk.io>",
  "homepage": "https://github.com/davidwkeith/workers/tree/main/packages/webfinger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidwkeith/workers.git",
    "directory": "packages/webfinger"
  },
  "bugs": {
    "url": "https://github.com/davidwkeith/workers/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dwk/log": "workspace:*",
    "@dwk/safe-fetch": "workspace:*"
  }
}
