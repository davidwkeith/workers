{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No `rootDir`: the `paths` mapping below resolves the `@dwk/log` import to
    // its source (so `typecheck` works before the workspace is built — CI runs
    // typecheck ahead of build), which would otherwise trip the
    // rootDir-containment check. This config is `noEmit`, so rootDir is moot.
    "paths": {
      "@dwk/log": ["../log/src/index.ts"]
    },
    "types": ["@cloudflare/workers-types"],
    "noEmit": true
  },
  "include": ["src"]
}
