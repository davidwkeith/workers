{
  "name": "@dwk/mf2",
  "version": "0.1.0-beta.0",
  "description": "HTML-embedded microformats2 (h-entry/h-card) extraction via the Workers runtime's HTMLRewriter, plus a capture-time allowlist sanitizer for untrusted received content.",
  "keywords": [
    "microformats2",
    "mf2",
    "h-entry",
    "h-card",
    "indieweb",
    "jf2",
    "cloudflare-workers"
  ],
  "type": "module",
  "license": "ISC",
  "author": "David W. Keith <me@dwk.io>",
  "homepage": "https://github.com/davidwkeith/workers/tree/main/packages/mf2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidwkeith/workers.git",
    "directory": "packages/mf2"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {}
}
