{
  "name": "@dwk/rdf",
  "version": "0.1.0-beta.2",
  "description": "Thin Turtle/JSON-LD parse and serialize layer over N3.js. Cross-standard reusable.",
  "keywords": [
    "rdf",
    "turtle",
    "json-ld",
    "n3",
    "linked-data",
    "solid"
  ],
  "type": "module",
  "license": "ISC",
  "author": "David W. Keith <me@dwk.io>",
  "homepage": "https://github.com/davidwkeith/workers/tree/main/packages/rdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidwkeith/workers.git",
    "directory": "packages/rdf"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/n3": "1.26.1",
    "n3": "2.1.1"
  }
}
