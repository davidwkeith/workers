# Overrides for docker-compose.yml (central-mode reference deployment).
# Copy to `.env` in this directory and edit, or export these in your shell —
# every value here has a working default baked into docker-compose.yml, so
# this file only needs entries you actually want to change.

# Public origin the fleet is reached at (identity is HTTPS-rooted — put a
# TLS-terminating reverse proxy in front of the `proxy` service for anything
# beyond local testing; see README.md "Security").
DWK_BASE_URL=http://localhost:8000

# MinIO root credentials — also used as the S3 access key/secret the
# replicas sign requests with. Change before exposing MinIO's ports beyond
# localhost.
DWK_S3_ACCESS_KEY_ID=dwk-minio
DWK_S3_SECRET_ACCESS_KEY=dwk-minio-secret

# Signs IndieAuth tokens — generate a real secret for anything beyond local
# testing (e.g. `openssl rand -base64 32`).
DWK_TOKEN_SIGNING_KEY=dev-signing-key-change-me
