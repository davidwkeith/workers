{
  "name": "@dwk/server",
  "version": "0.1.0-beta.3",
  "private": true,
  "description": "Node.js/Express self-hosting host for the @dwk packages: Express⇄Fetch adapter, static hosting, and Node-backed shims (SQLite/filesystem) for the Cloudflare binding interfaces.",
  "keywords": [
    "self-hosting",
    "express",
    "cloudflare-workers",
    "node-sqlite",
    "indieweb",
    "solid"
  ],
  "type": "module",
  "license": "ISC",
  "author": "David W. Keith <me@dwk.io>",
  "homepage": "https://github.com/davidwkeith/workers/tree/main/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidwkeith/workers.git",
    "directory": "packages/server"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dwk-serve": "./bin/dwk-serve.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "src",
    "examples",
    "scripts",
    "Dockerfile",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist dist-bundle"
  },
  "dependencies": {
    "@dwk/log": "workspace:*",
    "@worker-tools/html-rewriter": "0.1.0-pre.19",
    "express": "5.2.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260718.1",
    "esbuild": "0.28.1",
    "@dwk/host-meta": "workspace:*",
    "@dwk/indieauth": "workspace:*",
    "@dwk/ldn": "workspace:*",
    "@dwk/micropub": "workspace:*",
    "@dwk/microsub": "workspace:*",
    "@dwk/solid-pod": "workspace:*",
    "@dwk/store": "workspace:*",
    "@dwk/vc": "workspace:*",
    "@dwk/wac": "workspace:*",
    "@dwk/webauthn": "workspace:*",
    "@dwk/webfinger": "workspace:*",
    "@dwk/webmention": "workspace:*",
    "@dwk/websub": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/ws": "8.18.1"
  }
}
