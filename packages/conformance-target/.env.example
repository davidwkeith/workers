# Variables for deploying @dwk/conformance-target (conformance.dwk.io).
# Copy to `.env` here (gitignored): wrangler reads it when run from this directory.
# Self-hosting with @dwk/server has its own template: packages/server/.env.example.
# Setup and deploy steps: README.md → "One-time setup" and "Deploy".

# --- wrangler auth (not needed after `wrangler login`) ---
# Token scopes: Workers Scripts:Edit, Workers Routes:Edit, D1:Edit, Queues:Edit, R2:Edit.
# The same two are GitHub repo secrets for the Conformance workflow's deploy job.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Owner bearer for `POST /admin/init` and `/webmention/send` after deploy ---
# Same value as the CONFORMANCE_ADMIN_TOKEN Worker secret below.
CONFORMANCE_ADMIN_TOKEN=

# --- Worker secrets: NOT read from this file ---
# Set each with `wrangler secret put <NAME>` (README.md step 3 has the commands;
# pipe or redirect values in, never paste multi-line ones at the prompt), or put
# them in `.dev.vars` for `wrangler dev`. BASE_URL is a var in wrangler.jsonc.
#
# TOKEN_SIGNING_KEY=            # random
# CONFORMANCE_PASSWORD=         # random; IndieAuth consent form password
# CONFORMANCE_ADMIN_TOKEN=      # random; owner bearer (keep it, see above)
# ACTIVITYPUB_PUBLIC_KEY_PEM=   # RSA 2048 PEM
# ACTIVITYPUB_PRIVATE_KEY_PEM=  # RSA 2048 PEM
# ACTIVITYPUB_PUBLISH_TOKEN=    # random; optional, enables owner publishing
# ATPROTO_PASSWORD=             # random
# ATPROTO_JWT_SECRET=           # random
# VC_SIGNING_KEY=               # P-256 private JWK

# --- Optional GitHub repo secrets for the hosted suites (.github/workflows/conformance.yml) ---
# FEDIFY_PUBLISH_TOKEN=         # same value as ACTIVITYPUB_PUBLISH_TOKEN; else publish cases skip
# WEBDAV_USERNAME=              # app password from /dav-credentials, for litmus
# WEBDAV_PASSWORD=
