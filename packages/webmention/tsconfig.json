{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No `rootDir`: the `paths` mapping below resolves the `@dwk/log` import to
    // its source (so `typecheck` works before the workspace is built — CI runs
    // typecheck ahead of build), which would otherwise trip the
    // rootDir-containment check. This config is `noEmit`, so rootDir is moot.
    "paths": {
      // `@dwk/dpop` isn't a direct dependency of this package, but `@dwk/mcp`'s
      // own source (path-mapped below) imports it for its auth bridge, and
      // that import resolves under THIS program's paths — so it needs an
      // entry here too, or typecheck fails before `@dwk/dpop` is built.
      "@dwk/dpop": ["../dpop/src/index.ts"],
      "@dwk/log": ["../log/src/index.ts"],
      "@dwk/mcp": ["../mcp/src/index.ts"],
      "@dwk/mf2": ["../mf2/src/index.ts"],
      "@dwk/safe-fetch": ["../safe-fetch/src/index.ts"]
    },
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "noEmit": true
  },
  "include": ["src"]
}
