{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No `rootDir`: the `paths` mappings below resolve the workspace imports to
    // their source (so `typecheck` works before the workspace is built — CI runs
    // typecheck ahead of build), which would otherwise trip the
    // rootDir-containment check. This config is `noEmit`, so rootDir is moot.
    "paths": {
      "@dwk/dpop": ["../dpop/src/index.ts"],
      "@dwk/indieauth": ["../indieauth/src/index.ts"],
      "@dwk/log": ["../log/src/index.ts"],
      "@dwk/mcp": ["../mcp/src/index.ts"],
      "@dwk/mf2": ["../mf2/src/index.ts"],
      "@dwk/safe-fetch": ["../safe-fetch/src/index.ts"]
    },
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "noEmit": true
  },
  "include": ["src"]
}
